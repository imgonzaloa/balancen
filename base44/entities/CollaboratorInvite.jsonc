{
  "name": "CollaboratorInvite",
  "type": "object",
  "properties": {
    "inviter_email": {
      "type": "string",
      "description": "Email of the user who sent the invite"
    },
    "invitee_email": {
      "type": "string",
      "description": "Email of the invited collaborator"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending",
      "description": "Invite status"
    },
    "invite_code": {
      "type": "string",
      "description": "Unique invite code"
    }
  },
  "required": [
    "inviter_email",
    "invitee_email"
  ]
}