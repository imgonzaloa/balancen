{
  "name": "WorkoutPlan",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "plan_name": {
      "type": "string",
      "description": "Name of workout plan"
    },
    "focus": {
      "type": "string",
      "enum": [
        "strength",
        "hypertrophy",
        "endurance",
        "mixed"
      ],
      "description": "Training focus"
    },
    "duration_weeks": {
      "type": "number",
      "description": "Plan duration in weeks"
    },
    "days_per_week": {
      "type": "number",
      "minimum": 1,
      "maximum": 7
    },
    "current_week": {
      "type": "number",
      "default": 1
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exercise_name": {
            "type": "string"
          },
          "muscle_groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sets": {
            "type": "number"
          },
          "reps_min": {
            "type": "number"
          },
          "reps_max": {
            "type": "number"
          },
          "rest_seconds": {
            "type": "number"
          },
          "progression_strategy": {
            "type": "string"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          }
        }
      },
      "description": "List of exercises"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Was generated by AI"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_email",
    "plan_name",
    "focus"
  ]
}