{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_email": {
      "type": "string",
      "description": "Email of the post author"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of author"
    },
    "author_avatar": {
      "type": "string",
      "description": "Author's avatar URL"
    },
    "content": {
      "type": "string",
      "description": "Post text content"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "status",
        "achievement",
        "meal",
        "progress"
      ],
      "default": "status",
      "description": "Type of post"
    },
    "image_url": {
      "type": "string",
      "description": "Optional image attached to post"
    },
    "meal_data": {
      "type": "object",
      "properties": {
        "calories": {
          "type": "number"
        },
        "protein": {
          "type": "number"
        },
        "carbs": {
          "type": "number"
        },
        "fats": {
          "type": "number"
        }
      },
      "description": "Meal nutrition data if post_type is meal"
    },
    "achievement_data": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "badge_id": {
          "type": "string"
        }
      },
      "description": "Achievement details if post_type is achievement"
    },
    "group_id": {
      "type": "string",
      "description": "Group this post belongs to (null for personal feed)"
    },
    "likes_count": {
      "type": "number",
      "default": 0,
      "description": "Number of likes"
    },
    "comments_count": {
      "type": "number",
      "default": 0,
      "description": "Number of comments"
    }
  },
  "required": [
    "author_email",
    "author_name",
    "post_type"
  ],
  "rls": {
    "create": {
      "data.author_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.author_email": "{{user.email}}",
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "data.author_email": "{{user.email}}",
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}